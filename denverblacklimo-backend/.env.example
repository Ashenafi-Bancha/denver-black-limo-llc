# ─────────────────────────────────────────
# Denver Black Limo – Backend Environment
# ─────────────────────────────────────────

# ── Database ──────────────────────────────
# Get this from neon.tech (free Postgres cloud db). On DigitalOcean, this is
# auto-injected as ${db.DATABASE_URL}. Schema is managed by SQL migrations in
# ./migrations — run `npm run migrate` (also runs automatically on server boot).
DATABASE_URL="postgresql://user:password@ep-your-project.us-east-2.aws.neon.tech/neondb?sslmode=require"

# SSL is auto-enabled when the URL contains `sslmode=require` (Neon & DigitalOcean).
# Only set this to override: "true" forces SSL, "false" disables it (e.g. a plain
# local Postgres with no SSL). Leave unset for normal cloud usage.
# DATABASE_SSL="false"

# ── Auth ──────────────────────────────────
# Change these to secure random values in production!
JWT_SECRET="change-this-to-a-secure-random-string"
ADMIN_PASSWORD="change-this-to-a-secure-password"

# ── CORS ──────────────────────────────────
ALLOWED_ORIGIN="http://localhost:5173"

# ── Admin Credentials ─────────────────────
# Who may sign in to the admin dashboard. Comma-separate to allow several
# people (owner + whoever is testing); they all share ADMIN_PASSWORD.
ADMIN_EMAIL="admin@denverblacklimo.com"
# ADMIN_EMAIL="owner@gmail.com,tester@gmail.com"

# ── Email (Resend) ────────────────────────
# Sign up free at https://resend.com
# Dashboard → API Keys → Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Where admin booking + inquiry alerts are sent. Comma-separate for several
# recipients. Falls back to ADMIN_EMAIL if unset.
ADMIN_NOTIFY_EMAIL="yourname@gmail.com"
# ADMIN_NOTIFY_EMAIL="owner@gmail.com,tester@gmail.com"

# The FROM address for outgoing emails.
# Use "onboarding@resend.dev" for testing (free, no domain needed).
# For production: verify your domain in Resend and use "noreply@denverblacklimo.com"
SENDER_EMAIL="onboarding@resend.dev"
